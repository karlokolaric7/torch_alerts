# ─── Required ────────────────────────────────────────────────────────────────

# HTTP(S) JSON-RPC endpoint for Robinhood Chain (chain id 4663).
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional WebSocket JSON-RPC endpoint (ws:// or wss://) for instant 0ms push subscriptions.
# When set, the bot subscribes via WebSocket and keeps fast HTTP polling as an automatic fallback.
WS_RPC_URL=

# Bot token from @BotFather. The bot must be an admin of the channel
# with permission to post messages.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExample

# Target channel: either "@public_channel_username" or a numeric id like -1001234567890.
TELEGRAM_CHANNEL_ID=@your_channel

# Set to false if you only want to send filtered private DM alerts to subscribed users
# without posting to the public TELEGRAM_CHANNEL_ID.
POST_TO_CHANNEL=true

# ─── Optional: Detection ─────────────────────────────────────────────────────

# Torch launchpad factory contract (default shown).
FACTORY_ADDRESS=0x7891eA889899928aFE637e4Cca8106188427776a

# Real Torch tokens are vanity addresses ending in this hex suffix.
TOKEN_SUFFIX=1111

# topic0 (keccak hash) of the factory's TokenLaunched event. Verified on mainnet:
# emitted once per new token. Leave empty to fall back to ABI-agnostic detection.
LAUNCH_EVENT_TOPIC=0xea6baf14ec1f4c08d18114c1eea0e6a2a018eef994f9db19ea8a41526e49d28c

# Verify each candidate token had no bytecode in the block before it was
# seen (used when LAUNCH_EVENT_TOPIC is empty).
VERIFY_FRESH_DEPLOY=true

# ─── Optional: Graduation ("Launch Complete" ~10x) Detection ─────────────────

# Enable monitoring of launched Torch tokens for the ~10x "Launch Complete" milestone.
ENABLE_GRADUATION_ALERTS=true

# Multiple of starting market cap that marks a token as Graduated / Launch Complete (default 10 = 10x).
GRADUATION_MULTIPLIER=10

# Uniswap v4 PoolManager contract on Robinhood Chain used to monitor Swap events.
POOL_MANAGER_ADDRESS=0x8366a39CC670B4001A1121B8F6A443A643e40951

# How often (ms) to check Swap logs across tracked tokens for graduation.
GRADUATION_CHECK_INTERVAL_MS=2400

# ─── Optional: Global Channel Filters ────────────────────────────────────────

# Minimum starting market cap in quote currency units (0 = disabled).
MIN_MARKET_CAP_ETH=0

# Maximum starting market cap in quote currency units (0 = disabled).
MAX_MARKET_CAP_ETH=0

# Allowed base buy tax range in percent (0..100 = allow all).
MIN_BUY_TAX_PCT=0
MAX_BUY_TAX_PCT=100

# Minimum initial creator/dev buy in quote currency units (0 = disabled).
MIN_INITIAL_BUY_ETH=0

# Maximum % of total supply bought in the launch transaction (100 = disabled).
MAX_INITIAL_BUY_PCT=100

# Set to true to only alert on tokens paired against native ETH.
ONLY_ETH_PAIRS=false

# ─── Optional: Links, Cards, User Filters & Runtime ──────────────────────────

# Direct trade link template. "{address}" is replaced with the token address.
TOKEN_URL_TEMPLATE=https://app.torchpad.fun/trade/robinhood/{address}

# Attach a generated 1200x675 dark-themed PNG image card to each Telegram alert.
INCLUDE_IMAGE_CARD=true

# Post the text alert to the public channel immediately upon detection (~150-350ms),
# and send the generated PNG launch card as a non-blocking follow-up right after.
FAST_CHANNEL_TEXT_FIRST=true

# Enable interactive Telegram bot commands (/setminmc, /setmaxtax, /filters, /resetfilters, /help).
ENABLE_BOT_COMMANDS=true

# Where per-user Telegram filter settings are persisted.
USER_FILTERS_FILE=./data/users.json

# Block explorer base URL used for links in alerts.
EXPLORER_URL=https://robinhoodchain.blockscout.com

# Print alerts to the console instead of posting to Telegram (no bot needed).
DRY_RUN=false

# How often to poll for new blocks (ms) when using single-RTT batched HTTP polling.
POLL_INTERVAL_MS=600

# Max blocks per eth_getLogs request (automatically halved if the RPC objects).
MAX_BLOCK_RANGE=2000

# Blocks to wait before processing (0 = process at chain head).
CONFIRMATIONS=0

# Block to start from on the very first run (no saved state). Empty = start at chain head.
START_BLOCK=

# Where dedup state (seen tokens + seen txs + last processed block) is persisted.
STATE_FILE=./data/state.json

# debug | info | warn | error
LOG_LEVEL=info
